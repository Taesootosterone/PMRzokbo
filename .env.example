# PMRtest/NOAH의 설정과 독립적입니다. 절대 경로를 사용하세요.
PMRZ_PORT=4310
PMRZ_HOST=127.0.0.1
# macOS 기본: ~/Library/Application Support/PMRZokbo
# PMRZ_DATA_DIR=/Users/your-name/Library/Application Support/PMRZokbo
# GitHub 원본. PMRtest 저장소를 지정하지 마세요.
PMRZ_UPDATE_REPOSITORY=Taesootosterone/PMRzokbo
PMRZ_UPDATE_BRANCH=main
# 확인·다운로드만 자동으로 진행하고, 적용은 설정의 버튼으로 합니다.
PMRZ_AUTO_UPDATE_CHECK=1
PMRZ_UPDATE_CHECK_HOURS=6
