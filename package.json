{
  "name": "pmrzokbo",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "backup": "node --env-file-if-exists=.env.local scripts/data.mjs backup",
    "restore": "node --env-file-if-exists=.env.local scripts/data.mjs restore",
    "demo": "node --env-file-if-exists=.env.local scripts/demo.mjs",
    "mac:setup": "node scripts/mac-apps.mjs setup",
    "mac:open": "node scripts/mac-apps.mjs open",
    "mac:update": "node scripts/mac-apps.mjs update",
    "mac:stop": "node scripts/mac-apps.mjs stop",
    "mac:status": "node scripts/mac-apps.mjs status"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "fast-xml-parser": "5.12.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.34.5",
    "tesseract.js": "7.0.0",
    "yauzl": "3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jszip": "3.10.1",
    "pptxgenjs": "4.0.1",
    "typescript": "^5.9.3"
  }
