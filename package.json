{
  "name": "pmrzokbo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "backup": "node --env-file-if-exists=.env.local scripts/data.mjs backup",
    "restore": "node --env-file-if-exists=.env.local scripts/data.mjs restore",
    "demo": "node --env-file-if-exists=.env.local scripts/demo.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "^0.577.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
